{
   "$and": [
      {
         "$jsonSchema": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
               "_id",
               "userId",
               "credentialsVersion",
               "tokenHash",
               "lastActiveAt",
               "ipAddress",
               "userAgent",
               "absoluteExpiresAt",
               "expiresAt",
               "createdAt",
               "updatedAt"
            ],
            "properties": {
               "_id": { "bsonType": "objectId" },
               "userId": { "bsonType": "objectId" },
               "credentialsVersion": { "bsonType": "int", "minimum": 0 },
               "tokenHash": {
                  "bsonType": "string",
                  "pattern": "^[a-f0-9]{64}\\z"
               },
               "lastActiveAt": { "bsonType": "date" },
               "ipAddress": {
                  "bsonType": ["string", "null"],
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[0-9a-fA-F:.]+(%[0-9A-Za-z._-]+)?\\z"
               },
               "userAgent": {
                  "bsonType": ["string", "null"],
                  "minLength": 1,
                  "maxLength": 2056,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?\\z"
               },
               "absoluteExpiresAt": { "bsonType": "date" },
               "expiresAt": { "bsonType": "date" },
               "createdAt": { "bsonType": "date" },
               "updatedAt": { "bsonType": "date" }
            }
         }
      },
      {
         "$expr": {
            "$and": [
               { "$lte": ["$createdAt", "$updatedAt"] },
               { "$gte": ["$lastActiveAt", "$createdAt"] },
               { "$gt": ["$expiresAt", "$createdAt"] },
               { "$gt": ["$absoluteExpiresAt", "$createdAt"] },
               { "$lte": ["$expiresAt", "$absoluteExpiresAt"] }
            ]
         }
      }
   ]
}
