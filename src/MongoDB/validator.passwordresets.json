{
   "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
         "_id",
         "tokenHash",
         "userId",
         "email",
         "expiresAt",
         "createdAt",
         "updatedAt"
      ],
      "properties": {
         "_id": { "bsonType": "objectId" },
         "tokenHash": { "bsonType": "string", "pattern": "^[a-f0-9]{64}\\z" },
         "userId": { "bsonType": "objectId" },
         "email": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.)(?!.*\\.\\.)([a-z0-9_'+\\-.]*)[a-z0-9_+-]@([a-z0-9][a-z0-9-]*\\.)+[a-z]{2,}\\z"
         },
         "expiresAt": { "bsonType": "date" },
         "createdAt": { "bsonType": "date" },
         "updatedAt": { "bsonType": "date" }
      }
   }
}
