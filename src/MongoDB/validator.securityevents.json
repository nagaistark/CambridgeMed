{
   "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
         "_id",
         "occurredAt",
         "event",
         "severity",
         "actorId",
         "targetUserId",
         "requestId",
         "ipAddress",
         "secondFactorPurpose",
         "secondFactorKind"
      ],
      "properties": {
         "_id": { "bsonType": "objectId" },
         "occurredAt": { "bsonType": "date" },
         "event": {
            "bsonType": "string",
            "enum": [
               "TOTP_ENROLLMENT_STARTED",
               "TOTP_ENABLED",
               "TOTP_DISABLED",
               "TOTP_RECOVERY_CODES_REGENERATED",
               "TOTP_RESET_BY_ADMIN",
               "TOTP_RESET_BY_EMAIL_REVERT",
               "SECOND_FACTOR_FAILED",
               "SECOND_FACTOR_LOCKED",
               "RECOVERY_CODE_USED",
               "SESSION_TERMINATED",
               "SESSION_TERMINATED_BY_ADMIN",
               "PASSWORD_CHANGED",
               "PASSWORD_RESET_COMPLETED",
               "EMAIL_CHANGE_REQUESTED",
               "EMAIL_CHANGE_CONFIRMED",
               "EMAIL_CHANGE_CANCELLED",
               "EMAIL_CHANGE_REVERTED",
               "ACCOUNT_ACTIVATED",
               "ACCOUNT_DEACTIVATED",
               "INVITE_PRIVILEGE_GRANTED",
               "INVITE_PRIVILEGE_REVOKED"
            ]
         },
         "severity": { "bsonType": "string", "enum": ["info", "warn"] },
         "actorId": { "bsonType": ["objectId", "null"] },
         "targetUserId": { "bsonType": "objectId" },
         "requestId": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?\\z"
         },
         "ipAddress": {
            "bsonType": ["string", "null"],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9a-fA-F:.]+(%[0-9A-Za-z._-]+)?\\z"
         },
         "secondFactorPurpose": {
            "bsonType": ["string", "null"],
            "enum": [
               "login",
               "password-reset",
               "disable",
               "regenerate-codes",
               "admin-reset",
               null
            ]
         },
         "secondFactorKind": {
            "bsonType": ["string", "null"],
            "enum": ["totp", "recovery", null]
         }
      },
      "allOf": [
         {
            "oneOf": [
               {
                  "properties": {
                     "event": {
                        "enum": [
                           "TOTP_ENROLLMENT_STARTED",
                           "TOTP_ENABLED",
                           "TOTP_RECOVERY_CODES_REGENERATED",
                           "SESSION_TERMINATED",
                           "PASSWORD_CHANGED",
                           "EMAIL_CHANGE_REQUESTED",
                           "EMAIL_CHANGE_CANCELLED",
                           "INVITE_PRIVILEGE_REVOKED"
                        ]
                     },
                     "severity": { "enum": ["info"] }
                  }
               },
               {
                  "properties": {
                     "event": {
                        "enum": [
                           "TOTP_DISABLED",
                           "TOTP_RESET_BY_ADMIN",
                           "TOTP_RESET_BY_EMAIL_REVERT",
                           "SECOND_FACTOR_FAILED",
                           "SECOND_FACTOR_LOCKED",
                           "RECOVERY_CODE_USED",
                           "SESSION_TERMINATED_BY_ADMIN",
                           "PASSWORD_RESET_COMPLETED",
                           "EMAIL_CHANGE_CONFIRMED",
                           "EMAIL_CHANGE_REVERTED",
                           "ACCOUNT_ACTIVATED",
                           "ACCOUNT_DEACTIVATED",
                           "INVITE_PRIVILEGE_GRANTED"
                        ]
                     },
                     "severity": { "enum": ["warn"] }
                  }
               }
            ]
         },
         {
            "oneOf": [
               {
                  "properties": {
                     "event": {
                        "enum": [
                           "SECOND_FACTOR_FAILED",
                           "SECOND_FACTOR_LOCKED",
                           "RECOVERY_CODE_USED"
                        ]
                     },
                     "secondFactorPurpose": { "bsonType": "string" },
                     "secondFactorKind": { "bsonType": "string" }
                  }
               },
               {
                  "properties": {
                     "event": {
                        "enum": [
                           "TOTP_ENROLLMENT_STARTED",
                           "TOTP_ENABLED",
                           "TOTP_DISABLED",
                           "TOTP_RECOVERY_CODES_REGENERATED",
                           "TOTP_RESET_BY_ADMIN",
                           "TOTP_RESET_BY_EMAIL_REVERT",
                           "SESSION_TERMINATED",
                           "SESSION_TERMINATED_BY_ADMIN",
                           "PASSWORD_CHANGED",
                           "PASSWORD_RESET_COMPLETED",
                           "EMAIL_CHANGE_REQUESTED",
                           "EMAIL_CHANGE_CONFIRMED",
                           "EMAIL_CHANGE_CANCELLED",
                           "EMAIL_CHANGE_REVERTED",
                           "ACCOUNT_ACTIVATED",
                           "ACCOUNT_DEACTIVATED",
                           "INVITE_PRIVILEGE_GRANTED",
                           "INVITE_PRIVILEGE_REVOKED"
                        ]
                     },
                     "secondFactorPurpose": { "bsonType": "null" },
                     "secondFactorKind": { "bsonType": "null" }
                  }
               }
            ]
         }
      ]
   }
}
