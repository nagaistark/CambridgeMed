{
   "$schema": "./node_modules/oxlint/configuration_schema.json",
   "plugins": ["typescript", "unicorn", "oxc"],
   "categories": {
      "correctness": "error"
   },
   "rules": {
      "no-console": "warn",
      "typescript/no-explicit-any": "allow",
      "no-unused-vars": [
         "deny",
         {
            "argsIgnorePattern": "^_",
            "ignoreRestSiblings": true
         }
      ],
      "prefer-const": "deny"
   },
   "env": {
      "builtin": true
   }
}
